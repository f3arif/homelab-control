+++ b/composeApp/src/commonTest/kotlin/com/nuvio/app/features/addons/AddonInstallationTest.kt
@@ -0,0 +1,103 @@
+package com.nuvio.app.features.addons
+
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitAll
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.runBlocking
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertFailsWith
+import kotlin.test.assertTrue
+
+class AddonInstallationTest {
+    @Test fun uppercaseHttpsPreservesProviderPathAndToken() {
+        assertEquals("https://example.test/Config/AbC/manifest.json?token=XyZ%2F",
+            normalizeAddonManifestUrl(" HTTPS://example.test/Config/AbC/?token=XyZ%2F#section "))
+    }
+
+    @Test fun mixedCaseHttpRemainsHttp() {
+        assertEquals("http://localhost:18774/manifest.json", normalizeAddonManifestUrl("HtTp://localhost:18774"))
+    }
+
+    @Test fun mixedCaseStremioAndHttpsHaveTheSameIdentity() {
+        assertEquals(normalizeAddonManifestUrl("HTTPS://example.test/Config/AbC"),
+            normalizeAddonManifestUrl("StReMiO://example.test/Config/AbC/manifest.json"))
+    }
+
+    @Test fun schemelessAddressKeepsPort() {
+        assertEquals("https://example.test:8443/Config/AbC/manifest.json", normalizeAddonManifestUrl("example.test:8443/Config/AbC/"))
+    }
+
+    @Test fun existingManifestSuffixIsNotAddedAgain() {
+        assertEquals("https://example.test/manifest.json?A=B", normalizeAddonManifestUrl("https://example.test/manifest.json/?A=B"))
+    }
+
+    @Test fun fragmentCannotBecomePartOfTheManifestPath() {
+        assertEquals("https://example.test/Config/manifest.json", normalizeAddonManifestUrl("https://example.test/Config#Install"))
+    }
+
+    @Test fun tokenAndPathCaseStillDistinguishConfigurations() {
+        assertFalse(normalizeAddonManifestUrl("https://example.test/AbC?token=XyZ") ==
+            normalizeAddonManifestUrl("https://example.test/abc?token=xyz"))
+    }
+
+    @Test fun blankInputIsRejected() {
+        assertFailsWith<IllegalArgumentException> { normalizeAddonManifestUrl("  ") }
+    }
+
+    @Test fun duplicateDoesNotReplaceExistingDisabledAddon() {
+        val original = ManagedAddon("https://example.test/manifest.json", enabled = false, userSetName = "Keep me")
+        val state = MutableStateFlow(AddonsUiState(listOf(original)))
+        assertFalse(state.installAddonIfAbsent(original.copy(enabled = true, userSetName = null)))
+        assertEquals(listOf(original), state.value.addons)
+    }
+
+    @Test fun concurrentCompletedFetchesInstallExactlyOnce() = runBlocking {
+        repeat(20) {
+            val state = MutableStateFlow(AddonsUiState())
+            val ready = CompletableDeferred<Unit>()
+            val results = (1..64).map {
+                async(Dispatchers.Default) {
+                    ready.await()
+                    state.installAddonIfAbsent(ManagedAddon("https://example.test/manifest.json"))
+                }
+            }
+            ready.complete(Unit)
+            assertEquals(1, results.awaitAll().count { it })
+            assertEquals(1, state.value.addons.size)
+        }
+    }
+
+    @Test fun concurrentDifferentAddonsAreNotLost() = runBlocking {
+        val state = MutableStateFlow(AddonsUiState())
+        val ready = CompletableDeferred<Unit>()
+        val results = (1..64).map { index ->
+            async(Dispatchers.Default) {
+                ready.await()
+                state.installAddonIfAbsent(ManagedAddon("https://example.test/$index/manifest.json"))
+            }
+        }
+        ready.complete(Unit)
+        assertTrue(results.awaitAll().all { it })
+        assertEquals(64, state.value.addons.map { it.manifestUrl }.distinct().size)
+    }
+
+    @Test fun freshInstallAfterRemovalStillWorks() {
+        val state = MutableStateFlow(AddonsUiState())
+        val addon = ManagedAddon("https://example.test/manifest.json")
+        assertTrue(state.installAddonIfAbsent(addon))
+        state.value = AddonsUiState()
+        assertTrue(state.installAddonIfAbsent(addon))
+        assertEquals(listOf(addon), state.value.addons)
+    }
+
+    @Test fun differentSchemeInputsShareOneInstallSlot() {
+        val state = MutableStateFlow(AddonsUiState())
+        assertTrue(state.installAddonIfAbsent(ManagedAddon(normalizeAddonManifestUrl("HTTPS://example.test/Config/AbC"))))
+        assertFalse(state.installAddonIfAbsent(ManagedAddon(normalizeAddonManifestUrl("stremio://example.test/Config/AbC"))))
+        assertEquals(1, state.value.addons.size)
+    }
+}
