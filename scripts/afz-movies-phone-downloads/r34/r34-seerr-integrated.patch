@@ -0,0 +1,83 @@
+package com.nuvio.app.core.auth
+
+import com.nuvio.app.core.network.ServerConfigurationRepository
+import com.nuvio.app.core.network.SupabaseProvider
+import io.github.jan.supabase.auth.auth
+import io.ktor.http.Url
+import kotlinx.coroutines.withTimeout
+
+/** Public identifiers only. Never include session material in the copy payload. */
+data class AccountLinkingDetails(val accountId: String, val serverOrigin: String, val email: String) {
+    fun copyText(): String = "Account UUID: $accountId\nAccount server origin: $serverOrigin"
+}
+
+internal data class AccountLinkingScope(
+    val accountId: String,
+    val email: String?,
+    val anonymous: Boolean,
+    val serverUrl: String,
+    val clientServerUrl: String = serverUrl,
+)
+internal data class AccountLinkingUser(val accountId: String, val email: String?, val anonymous: Boolean, val emailConfirmed: Boolean)
+
+/** The configured authentication origin, not a web page or a profile identifier. */
+internal fun accountServerOrigin(serverUrl: String): String {
+    require(serverUrl.isNotEmpty() && serverUrl.none { it.isWhitespace() || it == '\\' })
+    val url = Url(serverUrl)
+    require(url.protocol.name == "https" && url.host.isNotBlank())
+    require(url.user == null && url.password == null && url.parameters.isEmpty() && url.fragment.isEmpty())
+    require(url.encodedPath.isEmpty() || url.encodedPath == "/")
+    val host = url.host.lowercase().let { if (':' in it && !it.startsWith('[')) "[$it]" else it }
+    return "https://$host" + if (url.port == 443) "" else ":${url.port}"
+}
+
+internal class AccountLinkingDetailsReader(
+    private val currentScope: () -> AccountLinkingScope?,
+    private val retrieveUser: suspend () -> AccountLinkingUser,
+) {
+    suspend fun verify(): AccountLinkingDetails {
+        val before = checkNotNull(currentScope())
+        require(!before.anonymous && uuid.matches(before.accountId) && !before.email.isNullOrBlank())
+        val origin = accountServerOrigin(before.serverUrl)
+        check(accountServerOrigin(before.clientServerUrl) == origin) { "Account client server changed" }
+        val remote = retrieveUser()
+        check(currentScope() == before) { "Account or server changed" }
+        require(!remote.anonymous && remote.emailConfirmed && remote.accountId == before.accountId)
+        require(remote.email?.equals(before.email, ignoreCase = true) == true)
+        return AccountLinkingDetails(remote.accountId, origin, checkNotNull(remote.email))
+    }
+
+    private companion object {
+        val uuid = Regex("[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}")
+    }
+}
+
+object AccountLinkingRepository {
+    /** Explicit read-only user lookup through the existing authenticated SDK client.
+     * Existing configured fallback routing stays within the app's account server setup;
+     * the exported origin is always the selected canonical backend configuration.
+     * No token parsing, storage, new login, account mutation or enrollment occurs here.
+     */
+    suspend fun verify(): AccountLinkingDetails {
+        val server = ServerConfigurationRepository.active.value
+        val client = SupabaseProvider.client
+        return AccountLinkingDetailsReader(
+            currentScope = {
+                val account = AuthRepository.state.value as? AuthState.Authenticated
+                if (account == null || ServerConfigurationRepository.active.value != server || SupabaseProvider.client !== client) null
+                else AccountLinkingScope(account.userId, account.email, account.isAnonymous, server.backendUrl, client.supabaseHttpUrl)
+            },
+            retrieveUser = {
+                val user = withTimeout(15_000) { client.auth.retrieveUserForCurrentSession(false) }
+                AccountLinkingUser(user.id, user.email, user.isAnonymous != false, user.emailConfirmedAt != null)
+            },
+        ).verify()
+    }
+
+    fun isCurrent(details: AccountLinkingDetails): Boolean {
+        val account = AuthRepository.state.value as? AuthState.Authenticated ?: return false
+        return !account.isAnonymous && account.userId == details.accountId &&
+            account.email?.equals(details.email, ignoreCase = true) == true &&
+            runCatching { accountServerOrigin(ServerConfigurationRepository.active.value.backendUrl) }.getOrNull() == details.serverOrigin
+    }
+}
