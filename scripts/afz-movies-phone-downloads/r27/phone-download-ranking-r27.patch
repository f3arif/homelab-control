+package com.nuvio.app.features.streams
+
+import kotlin.test.*
+
+class DeviceDownloadPickerTest {
+    private fun source(label: String, gb: Double? = null, addon: String = "AFZ") = StreamItem(
+        name = label, url = "https://example.test/${label.hashCode()}.mkv",
+        addonName = addon, addonId = "addon:$addon",
+        behaviorHints = StreamBehaviorHints(videoSize = gb?.let { (it * 1073741824).toLong() }),
+    )
+    private fun group(vararg streams: StreamItem, name: String = "AFZ") =
+        AddonStreamGroup(name, "addon:$name", streams.toList())
+    private fun picker(vararg groups: AddonStreamGroup, episode: Boolean = false, downloadOnly: Boolean = true) =
+        streamListPresentation(groups.toList(), DownloadDevice.Phone, episode, false, downloadOnly)
+    private fun StreamListPresentation.files() = groups.flatMap { it.streams }
+
+    @Test fun phonePickerDoesNotInheritPlaybackFirstHugeSourceOrder() {
+        val good = source("1080p WEB-DL", 4.0)
+        val mobile = source("1080p WEB-DL alternate", 5.5)
+        val saver = source("720p WEB-DL", 0.8)
+        val remux = source("2160p REMUX", 37.4)
+        val huge = source("2160p WEB-DL", 73.2)
+        val auto = source("AFZ Play Best 2160p", 37.4).copy(url = "https://example.test/auto-stream/tt123/best")
+        val result = picker(group(auto, remux, huge, saver, mobile, good))
+        assertEquals(good, result.recommendation?.stream)
+        assertEquals(listOf(mobile, saver, remux, huge), result.files())
+        assertEquals("Large / Original quality", result.groups.last().addonName)
+        assertFalse(auto in result.files())
+    }
+
+    @Test fun categoriesRankAcrossAddonsAndRetainFilesInsteadOfProviderAlphabeticalOrder() {
+        val best = source("1080p preferred", 4.0, "Z")
+        val mobile = source("1080p alternate", 5.0, "Z").copy(sourceName = "Z provider")
+        val saver = source("1080p compact", 1.0, "A").copy(sourceName = "A provider")
+        val unknown = source("1080p unknown", addon = "A")
+        val fourK = source("2160p compact", 6.0, "A")
+        val large = source("1080p original", 12.0, "A")
+        val result = picker(group(large, fourK, unknown, saver, name = "A"), group(mobile, best, name = "Z"))
+        assertEquals(best, result.recommendation?.stream)
+        assertEquals(listOf(mobile, saver, unknown, fourK, large), result.files())
+        assertEquals(listOf("Mobile · 1080p", "Data Saver", "Other 1080p sources", "4K sources", "Large / Original quality"),
+            result.groups.map { it.addonName })
+    }
+
+    @Test fun playbackKeepsItsOriginalGroupsAndDoesNotPromoteDownloadRecommendation() {
+        val best = source("AFZ Play Best 2160p", 37.4)
+        val groups = listOf(group(best, source("1080p phone", 4.0)), group(source("720p", 0.9), name = "Second"))
+        val result = streamListPresentation(groups, DownloadDevice.Phone, false, false, false)
+        assertSame(groups, result.groups)
+        assertNull(result.recommendation)
+        assertEquals(best, result.files().first())
+    }
+
+    @Test fun fixedMobileSizedFilesReplaceDynamicAutoChoicesInDownloadSheet() {
+        val fixed = source("1080p fixed", 4.0)
+        val auto = listOf("mobile", "saver", "1080p", "4k", "best").map {
+            source("AFZ Auto $it 1080p", 4.0).copy(url = "https://example.test/auto-stream/tt123/$it")
+        }
+        val result = picker(group(*(auto + fixed).toTypedArray()))
+        assertEquals(fixed, result.recommendation?.stream)
+        assertTrue(result.files().isEmpty())
+        assertNull(picker(group(*auto.toTypedArray())).recommendation)
+    }
+
+    @Test fun hugeSourcesCannotBecomePhoneRecommendationWhenTheyAreTheOnlyChoices() {
+        val remux = source("AFZ Auto Mobile 1080p REMUX", 37.4)
+        val huge = source("2160p", 73.2)
+        val result = picker(group(remux, huge))
+        assertNull(result.recommendation)
+        assertEquals(listOf(remux, huge), result.files())
+        assertEquals("Large / Original quality", result.groups.single().addonName)
+    }
+
+    @Test fun fourKAndRemuxAreExplicitAlternativesEvenWhenSmallEnough() {
+        val fourK = source("2160p", 4.0)
+        val remux = source("1080p REMUX", 4.0)
+        val result = picker(group(remux, fourK))
+        assertNull(result.recommendation)
+        assertEquals(listOf(fourK, remux), result.files())
+    }
+
+    @Test fun cached1080pWithinTargetIsPreferredToUncachedNearestSize() {
+        val uncached = source("1080p uncached", 4.0)
+        val cached = source("1080p ready", 3.5).copy(
+            debridCacheStatus = StreamDebridCacheStatus("p", "Provider", StreamDebridCacheState.CACHED))
+        val result = picker(group(uncached, cached))
+        assertEquals(cached, result.recommendation?.stream)
+    }
+
+    @Test fun misleadingNotCachedLabelsDoNotReceiveCachedPreference() {
+        val notCached = source("1080p not cached", 4.0)
+        val cached = source("1080p cached", 3.6)
+        assertEquals(cached, picker(group(notCached, cached)).recommendation?.stream)
+        val structured = notCached.copy(name = "1080p cached", debridCacheStatus =
+            StreamDebridCacheStatus("p", "Provider", StreamDebridCacheState.NOT_CACHED))
+        assertFalse(structured.downloadIsCached())
+    }
+
+    @Test fun episodesUseTheirOwnBudgetAndMoveMovieSizedFilesToLargeSection() {
+        val episode = source("1080p S01E01", 0.9)
+        val big = source("1080p S01E01 large", 4.0)
+        val result = picker(group(big, episode), episode = true)
+        assertEquals(episode, result.recommendation?.stream)
+        assertEquals("Large / Original quality", result.groups.single().addonName)
+        assertTrue(result.recommendation!!.detail.contains("per episode"))
+    }
+
+    @Test fun loadingAndErrorsSurviveRegroupingAndEmptySourcesDoNotBecomeOffers() {
+        val loading = group().copy(isLoading = true)
+        val failure = group(name = "Other").copy(error = "Provider unavailable")
+        val result = picker(loading, failure)
+        assertEquals(listOf(loading, failure), result.groups)
+        assertTrue(result.files().isEmpty())
+    }
+
+    @Test fun supportedConcreteDownloadsAreFilteredWithoutChangingTheirIdentity() {
+        val good = source("1080p WEB-DL", 4.0)
+        val playlist = good.copy(url = "https://example.test/movie.m3u8")
+        val control = good.copy(name = "AFZ Request", addonName = "AFZ Movies & TV",
+            url = "https://example.test/request-play/tt123")
+        val torrent = good.copy(url = null, infoHash = "a".repeat(40))
+        val result = picker(group(playlist, control, torrent, good))
+        assertSame(good, result.recommendation?.stream)
+        assertTrue(result.files().isEmpty())
+    }
+
+    @Test fun structuredRemuxQualityIsKeptAtBottom() {
+        val remux = source("1080p", 4.0).copy(clientResolve = StreamClientResolve(
+            stream = StreamClientResolveStream(raw = StreamClientResolveRaw(parsed = StreamClientResolveParsed(quality = "REMUX")))))
+        val saver = source("720p", 0.8)
+        val result = picker(group(remux, saver))
+        assertEquals(saver, result.recommendation?.stream)
+        assertEquals("Large / Original quality", result.groups.single().addonName)
+    }
+
+    @Test fun tiesPreserveSourceOrderAndUnknownBytesAreNotPresentedAsRecommended() {
+        val first = source("1080p first")
+        val second = source("1080p second")
+        val result = picker(group(first, second))
+        assertEquals(first, result.recommendation?.stream)
+        assertTrue(result.recommendation!!.heading.startsWith("Closest available"))
+        assertEquals(listOf(second), result.files())
+    }
+}
