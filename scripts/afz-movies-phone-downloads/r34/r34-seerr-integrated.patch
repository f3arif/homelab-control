@@ -0,0 +1,34 @@
+(() => {
+  if (window.__afzSeerrNavigation) return;
+  window.__afzSeerrNavigation = true;
+  const style = document.createElement('style');
+  style.textContent = ':focus-visible,[data-afz-focus="true"]{outline:3px solid #22d3ee!important;outline-offset:4px!important;border-radius:8px}html{scroll-padding:24px}';
+  document.head.appendChild(style);
+  const candidates = () => [...document.querySelectorAll('a[href],button,input,select,textarea,[role="button"],[tabindex]')]
+    .filter(e => !e.disabled && e.getAttribute('aria-hidden') !== 'true' && e.tabIndex >= 0 && e.getClientRects().length && getComputedStyle(e).visibility !== 'hidden');
+  const mark = e => {
+    document.querySelectorAll('[data-afz-focus]').forEach(x => x.removeAttribute('data-afz-focus'));
+    e.dataset.afzFocus = 'true'; e.focus({preventScroll:true});
+    e.scrollIntoView({block:'nearest',inline:'nearest',behavior:'instant'});
+  };
+  document.addEventListener('keydown', e => {
+    if (!['ArrowLeft','ArrowRight','ArrowUp','ArrowDown','Enter'].includes(e.key)) return;
+    const active = document.activeElement;
+    if (active && ['INPUT','TEXTAREA','SELECT'].includes(active.tagName)) return;
+    const list = candidates();
+    if (!list.length) return;
+    if (!list.includes(active)) {e.preventDefault();mark(list[0]);return;}
+    if (e.key === 'Enter') {e.preventDefault();active.click();return;}
+    const r = active.getBoundingClientRect(), x = r.x+r.width/2, y = r.y+r.height/2;
+    const horizontal = ['ArrowLeft','ArrowRight'].includes(e.key);
+    const positive = ['ArrowRight','ArrowDown'].includes(e.key);
+    const next = list.filter(n => n !== active).map(n => {
+      const t=n.getBoundingClientRect(), dx=t.x+t.width/2-x, dy=t.y+t.height/2-y;
+      const primary=horizontal?dx:dy, secondary=horizontal?dy:dx;
+      const aligned=horizontal?Math.abs(dy)<Math.max(r.height,t.height)*0.6:Math.abs(dx)<Math.max(r.width,t.width)*0.6;
+      return {n,primary,score:Math.abs(primary)+Math.abs(secondary)*3+(aligned?0:10000)};
+    }).filter(n => positive?n.primary>4:n.primary< -4).sort((a,b)=>a.score-b.score)[0];
+    if (next) {e.preventDefault();mark(next.n);}
+    else if(e.key==='ArrowUp') {e.preventDefault();window.location.href='afz-seerr://toolbar';}
+  },true);
+})();
