@@ -0,0 +1,49 @@
+package com.nuvio.app.features.streams
+
+import kotlin.test.*
+
+class DownloadSizePresentationTest {
+    private fun source(resolution: String, sizes: String) = StreamItem(
+        name = "AFZ $resolution cached", description = sizes, url = "https://example.test/fixed.mkv",
+        addonName = "AFZ", addonId = "addon:AFZ")
+    private fun picker(stream: StreamItem) = streamListPresentation(
+        listOf(AddonStreamGroup("AFZ", "addon:AFZ", listOf(stream))), DownloadDevice.Phone, false, false, true)
+
+    @Test fun roundedDuplicateSizesKeepSixtyFiveGbFileInLargeSection() {
+        val large = source("2160p", "65.1 GB | Torrentio | cached | FullUHD\n65.11 GB")
+        assertEquals(65.11, large.downloadSizeGb())
+        assertNull(picker(large).recommendation)
+        assertEquals("Large / Original quality", picker(large).groups.single().addonName)
+    }
+
+    @Test fun consistentRoundedPhoneSizesStillReceiveRecommendation() {
+        val phone = source("1080p", "4.1 GB | cached | filename.mkv\n4.12 GB")
+        assertEquals(4.12, phone.downloadSizeGb())
+        assertEquals("Recommended for this phone", picker(phone).recommendation?.heading)
+    }
+
+    @Test fun aRoundedLabelCannotHideSizeAboveThePhoneLimit() {
+        val over = source("1080p", "5.0 GB | cached\n5.04 GB")
+        assertEquals(5.04, over.downloadSizeGb())
+        assertNull(picker(over).recommendation)
+    }
+
+    @Test fun inconsistentSizesDoNotBecomeATargetMatchedRecommendation() {
+        val conflict = source("1080p", "4.1 GB | cached\n41 GB")
+        assertNull(conflict.downloadSizeGb())
+        assertFalse(picker(conflict).recommendation?.heading == "Recommended for this phone")
+        assertEquals("Size unknown", picker(conflict).recommendation?.detail?.substringAfter(" · ")?.substringBefore(" · "))
+    }
+
+    @Test fun equivalentUnitsAndCommaDecimalLabelsAgree() {
+        assertEquals(4.0, source("1080p", "4 GB | 4096 MiB").downloadSizeGb())
+        assertEquals(4.12, source("1080p", "4,1 GB | 4,12 GB").downloadSizeGb())
+        assertNull(source("1080p", "4.1 GB | 4.2 GB").downloadSizeGb())
+    }
+
+    @Test fun structuredVideoSizeRemainsAuthoritative() {
+        val hint = source("1080p", "65.1 GB | 65.11 GB").copy(behaviorHints = StreamBehaviorHints(videoSize = 4L * 1073741824))
+        assertEquals(4.0, hint.downloadSizeGb())
+        assertEquals("Recommended for this phone", picker(hint).recommendation?.heading)
+    }
+}
diff --git a/composeApp/src/commonTest/kotlin/com/nuvio/app/features/streams/StreamLoadResultPolicyTest.kt b/composeApp/src/commonTest/kotlin/com/nuvio/app/features/streams/StreamLoadResultPolicyTest.kt
