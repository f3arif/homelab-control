@@ -0,0 +1,94 @@
+package com.nuvio.app.core.auth
+
+import io.github.jan.supabase.createSupabaseClient
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.runBlocking
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFailsWith
+import kotlin.test.assertFalse
+
+class AccountLinkingDetailsTest {
+    private val owner = "8f97ea26-7fb4-4ccd-9ab8-7ea08d693487"
+    private val other = "ab5522a9-34e1-499b-90cc-559512987593"
+    private val scope = AccountLinkingScope(owner, "fixture@example.invalid", false, "https://accounts.example.invalid/")
+    private val user = AccountLinkingUser(owner, scope.email, false, true)
+
+    @Test fun `actual SDK origin includes the scheme before account verification`() = runBlocking<Unit> {
+        // No Auth plugin, session storage or network calls: this tests SDK URL semantics.
+        val client = createSupabaseClient("https://fixture.accounts.invalid:8443", "fixture-publishable-key") {}
+        try {
+            assertEquals("fixture.accounts.invalid:8443", client.supabaseUrl)
+            assertEquals("https://fixture.accounts.invalid:8443", client.supabaseHttpUrl)
+            assertFailsWith<IllegalArgumentException> { accountServerOrigin(client.supabaseUrl) }
+            val binding = scope.copy(serverUrl = client.supabaseHttpUrl, clientServerUrl = client.supabaseHttpUrl)
+            assertEquals(client.supabaseHttpUrl, AccountLinkingDetailsReader({ binding }, { user }).verify().serverOrigin)
+        } finally {
+            client.close()
+        }
+    }
+
+    @Test fun `verified account exports only public identifiers`() = runBlocking<Unit> {
+        val details = AccountLinkingDetailsReader({ scope }, { user }).verify()
+        assertEquals(owner, details.accountId)
+        assertEquals("https://accounts.example.invalid", details.serverOrigin)
+        assertEquals("Account UUID: $owner\nAccount server origin: https://accounts.example.invalid", details.copyText())
+        assertFalse(details.copyText().contains(scope.email!!))
+    }
+
+    @Test fun `signed out fails without a network lookup`() = runBlocking<Unit> {
+        assertFailsWith<IllegalStateException> { AccountLinkingDetailsReader({ null }, { error("Must not call") }).verify() }
+    }
+
+    @Test fun `anonymous profile identifiers and unsafe origins fail before lookup`() = runBlocking<Unit> {
+        for (invalid in listOf(scope.copy(anonymous = true), scope.copy(accountId = "1"), scope.copy(email = null), scope.copy(serverUrl = "https://accounts.example.invalid/?access_token=secret"))) {
+            assertFailsWith<IllegalArgumentException> { AccountLinkingDetailsReader({ invalid }, { error("Must not call") }).verify() }
+        }
+    }
+
+    @Test fun `a stale client for a previous server fails before lookup`() = runBlocking<Unit> {
+        val invalid = scope.copy(clientServerUrl = "https://previous.example.invalid")
+        var lookups = 0
+        assertFailsWith<IllegalStateException> { AccountLinkingDetailsReader({ invalid }, { lookups++; user }).verify() }
+        assertEquals(0, lookups)
+    }
+
+    @Test fun `another authenticated owner is rejected`() = runBlocking<Unit> {
+        assertFailsWith<IllegalArgumentException> { AccountLinkingDetailsReader({ scope }, { user.copy(accountId = other) }).verify() }
+    }
+
+    @Test fun `anonymous unconfirmed or mismatched remote identity is rejected`() = runBlocking<Unit> {
+        for (remote in listOf(user.copy(anonymous = true), user.copy(emailConfirmed = false), user.copy(email = "other@example.invalid"), user.copy(email = null))) {
+            assertFailsWith<IllegalArgumentException> { AccountLinkingDetailsReader({ scope }, { remote }).verify() }
+        }
+    }
+
+    @Test fun `account change during the request discards the response`() = runBlocking<Unit> {
+        var current: AccountLinkingScope? = scope
+        val reader = AccountLinkingDetailsReader({ current }, { current = scope.copy(accountId = other); user })
+        assertFailsWith<IllegalStateException> { reader.verify() }
+    }
+
+    @Test fun `server change or logout during the request discards the response`() = runBlocking<Unit> {
+        for (changed in listOf(scope.copy(serverUrl = "https://other.example.invalid"), null)) {
+            var current: AccountLinkingScope? = scope
+            assertFailsWith<IllegalStateException> { AccountLinkingDetailsReader({ current }, { current = changed; user }).verify() }
+        }
+    }
+
+    @Test fun `offline failure never returns cached identifiers`() = runBlocking<Unit> {
+        assertFailsWith<IllegalStateException> { AccountLinkingDetailsReader({ scope }, { error("offline") }).verify() }
+    }
+
+    @Test fun `cancellation is preserved`() = runBlocking<Unit> {
+        assertFailsWith<CancellationException> { AccountLinkingDetailsReader({ scope }, { throw CancellationException() }).verify() }
+    }
+
+    @Test fun `origin preserves explicit port and excludes page paths`() {
+        assertEquals("https://accounts.example.invalid:8443", accountServerOrigin("https://ACCOUNTS.example.invalid:8443/"))
+        assertEquals("https://accounts.example.invalid", accountServerOrigin("https://accounts.example.invalid:443"))
+        for (url in listOf("http://accounts.example.invalid", "https://accounts.example.invalid/account", "https://user:password@accounts.example.invalid", "https://accounts.example.invalid/?access_token=secret", "https://accounts.example.invalid/#secret", "https://accounts.example.invalid/ ", "https://accounts.example.invalid\\other")) {
+            assertFailsWith<IllegalArgumentException>(url) { accountServerOrigin(url) }
+        }
+    }
+}
