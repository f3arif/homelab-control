+package com.nuvio.app.features.details.components
+
+import androidx.compose.material.icons.Icons
+import androidx.compose.material.icons.rounded.Download
+import com.nuvio.app.features.streams.DownloadDevice
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertNull
+import kotlin.test.assertSame
+
+class DetailActionPresentationTest {
+    private fun downloadAction(onClick: () -> Unit = {}) = DetailSecondaryAction(
+        label = "Download to device",
+        icon = Icons.Rounded.Download,
+        onClick = onClick,
+    )
+
+    @Test
+    fun televisionGetsVisibleRemoteFriendlyDownloadActionWithoutDuplicatingIt() {
+        var clicks = 0
+        val download = downloadAction { clicks++ }
+        val secondary = listOf(downloadAction())
+
+        val presentation = detailActionPresentation(
+            device = DownloadDevice.Television,
+            secondaryActions = secondary,
+            deviceDownloadAction = download,
+        )
+
+        assertNull(presentation.compactDownloadAction)
+        assertSame(download, presentation.tvDownloadAction)
+        assertSame(secondary, presentation.secondaryActions)
+        presentation.tvDownloadAction?.onClick?.invoke()
+        assertEquals(1, clicks)
+    }
+
+    @Test
+    fun phoneTabletAndComputerKeepExistingCompactDownloadPresentation() {
+        val download = downloadAction()
+        val secondary = listOf(downloadAction())
+
+        for (device in listOf(DownloadDevice.Phone, DownloadDevice.Tablet, DownloadDevice.Computer)) {
+            val presentation = detailActionPresentation(device, secondary, download)
+            assertSame(download, presentation.compactDownloadAction)
+            assertNull(presentation.tvDownloadAction)
+            assertSame(secondary, presentation.secondaryActions)
+        }
+    }
+
+    @Test
+    fun televisionWithoutDownloadCapabilityDoesNotInventAnAction() {
+        val presentation = detailActionPresentation(
+            device = DownloadDevice.Television,
+            secondaryActions = emptyList(),
+            deviceDownloadAction = null,
+        )
+        assertNull(presentation.compactDownloadAction)
+        assertNull(presentation.tvDownloadAction)
+        assertEquals(emptyList(), presentation.secondaryActions)
+    }
+}
