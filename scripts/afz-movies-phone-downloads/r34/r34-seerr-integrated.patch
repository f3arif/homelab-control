+@Composable
+private fun AccountLinkingCard(authState: AuthState) {
+    val server by ServerConfigurationRepository.active.collectAsStateWithLifecycle()
+    val scope = rememberCoroutineScope()
+    val clipboard = LocalClipboardManager.current
+    // Nothing is persisted; switching account/server discards displayed verification.
+    var details by remember(authState, server) { mutableStateOf<AccountLinkingDetails?>(null) }
+    var busy by remember(authState, server) { mutableStateOf(false) }
+    var failed by remember(authState, server) { mutableStateOf(false) }
+    var copied by remember(authState, server) { mutableStateOf(false) }
+
+    NuvioSurfaceCard {
+        Text(stringResource(Res.string.settings_account_linking_title), style = MaterialTheme.typography.titleMedium)
+        Spacer(Modifier.height(8.dp))
+        Text(stringResource(Res.string.settings_account_linking_description), style = MaterialTheme.typography.bodyMedium)
+        details?.let { verified ->
+            Spacer(Modifier.height(12.dp))
+            Text(verified.email, style = MaterialTheme.typography.bodyMedium)
+            Spacer(Modifier.height(8.dp))
+            Text(stringResource(Res.string.settings_account_linking_uuid), style = MaterialTheme.typography.labelMedium)
+            Text(verified.accountId, style = MaterialTheme.typography.bodyMedium)
+            Spacer(Modifier.height(8.dp))
+            Text(stringResource(Res.string.settings_account_linking_origin), style = MaterialTheme.typography.labelMedium)
+            Text(verified.serverOrigin, style = MaterialTheme.typography.bodyMedium)
+            Spacer(Modifier.height(12.dp))
+            NuvioPrimaryButton(text = stringResource(Res.string.settings_account_linking_copy), onClick = {
+                if (AccountLinkingRepository.isCurrent(verified)) {
+                    val payload = verified.copyText()
+                    copied = runCatching {
+                        clipboard.setText(AnnotatedString(payload))
+                        // Read only immediately after writing our known public payload.
+                        // Unexpected clipboard contents are never displayed or logged.
+                        clipboard.getText()?.text == payload
+                    }.getOrDefault(false)
+                    failed = !copied
+                } else {
+                    details = null
+                    failed = true
+                    copied = false
+                }
+            })
+        }
+        if (failed) {
+            Spacer(Modifier.height(8.dp))
+            // Never display server exception bodies, URLs, headers or session material.
+            Text(stringResource(Res.string.settings_account_linking_failed), color = MaterialTheme.colorScheme.error)
+        }
+        if (copied) {
+            Spacer(Modifier.height(8.dp))
+            Text(stringResource(Res.string.settings_account_linking_copied))
+        }
+        Spacer(Modifier.height(12.dp))
+        NuvioPrimaryButton(
+            text = stringResource(if (busy) Res.string.settings_account_linking_verifying else Res.string.settings_account_linking_verify),
+            enabled = !busy,
+            onClick = {
+                busy = true
+                details = null
+                failed = false
+                copied = false
+                scope.launch {
+                    try {
+                        details = AccountLinkingRepository.verify()
+                    } catch (_: TimeoutCancellationException) {
+                        failed = true
+                    } catch (cancelled: CancellationException) {
+                        throw cancelled
+                    } catch (_: Exception) {
+                        failed = true
+                    } finally {
+                        busy = false
+                    }
+                }
+            },
+        )
+    }
+}
