+package com.nuvio.app.features.seerr
+
+import android.annotation.SuppressLint
+import android.content.Intent
+import android.net.Uri
+import android.net.http.SslError
+import android.webkit.CookieManager
+import android.webkit.SslErrorHandler
+import android.webkit.WebChromeClient
+import android.webkit.WebResourceError
+import android.webkit.WebResourceRequest
+import android.webkit.WebResourceResponse
+import android.webkit.WebSettings
+import android.webkit.WebStorage
+import android.webkit.WebView
+import android.webkit.WebViewClient
+import androidx.activity.compose.BackHandler
+import androidx.compose.foundation.layout.*
+import androidx.compose.material.icons.Icons
+import androidx.compose.material.icons.filled.ArrowBack
+import androidx.compose.material.icons.filled.MoreVert
+import androidx.compose.material.icons.filled.Refresh
+import androidx.compose.material3.*
+import androidx.compose.runtime.*
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.draw.clipToBounds
+import androidx.compose.ui.focus.FocusRequester
+import androidx.compose.ui.focus.focusRequester
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.unit.dp
+import androidx.compose.ui.viewinterop.AndroidView
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.nuvio.app.core.auth.AuthRepository
+import com.nuvio.app.core.auth.userId
+import com.nuvio.app.core.ui.LocalNuvioBottomNavigationOverlayPadding
+import com.nuvio.app.core.ui.LocalScreenActive
+import com.nuvio.app.features.home.MetaPreview
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import org.json.JSONObject
+import java.security.MessageDigest
+import java.util.concurrent.TimeUnit
+
+actual val seerrSupported = true
+
+@Composable
+actual fun SeerrScreen(profileId: Int?, onOpenTitle: ((MetaPreview) -> Unit)?, modifier: Modifier) {
+    val auth by AuthRepository.state.collectAsStateWithLifecycle()
+    val accountId = auth.userId
+    if (accountId == null) {
+        Box(modifier.padding(24.dp)) { Text("Choose a Nuvio profile to browse Discover & Requests.") }
+        return
+    }
+    // Identity includes the Nuvio account as profile indices repeat across accounts.
+    key(accountId, profileId) {
+        SeerrBrowser("$accountId:${profileId ?: -1}", onOpenTitle, modifier)
+    }
+}
+
+@SuppressLint("SetJavaScriptEnabled")
+@Composable
+private fun SeerrBrowser(owner: String, onOpenTitle: ((MetaPreview) -> Unit)?, modifier: Modifier) {
+    val context = LocalContext.current
+    val active = LocalScreenActive.current
+    val activeNow by rememberUpdatedState(active)
+    val scope = rememberCoroutineScope()
+    val openTitle by rememberUpdatedState(onOpenTitle)
+    val toolbarFocus = remember { FocusRequester() }
+    var browser by remember { mutableStateOf<WebView?>(null) }
+    var progress by remember { mutableIntStateOf(0) }
+    var canGoBack by remember { mutableStateOf(false) }
+    var currentTitle by remember { mutableStateOf<SeerrTitle?>(null) }
+    var error by remember { mutableStateOf<String?>(null) }
+    var notice by remember { mutableStateOf<String?>(null) }
+    var openingTitle by remember { mutableStateOf(false) }
+    var menu by remember { mutableStateOf(false) }
+    var confirmSignOut by remember { mutableStateOf(false) }
+    var alive by remember { mutableStateOf(true) }
+    val ownerHash = remember(owner) {
+        MessageDigest.getInstance("SHA-256").digest(owner.toByteArray()).joinToString("") { "%02x".format(it) }
+    }
+    val preferences = remember { context.getSharedPreferences("afz_seerr_session", 0) }
+    val client = remember {
+        OkHttpClient.Builder().followRedirects(false).followSslRedirects(false)
+            .callTimeout(15, TimeUnit.SECONDS).build()
+    }
+
+    fun load(path: String) {
+        error = null
+        notice = null
+        browser?.loadUrl(SeerrPolicy.origin + path)
+    }
+
+    fun resetSession(view: WebView, then: () -> Unit) {
+        view.stopLoading()
+        view.clearHistory()
+        view.clearCache(true)
+        WebStorage.getInstance().deleteAllData()
+        // This application has no other WebView-based feature. Do not reuse this
+        // default store for future OAuth screens without adding isolated profiles.
+        CookieManager.getInstance().removeAllCookies {
+            if (alive) {
+                CookieManager.getInstance().flush()
+                preferences.edit().putString("owner", ownerHash).apply()
+                then()
+            }
+        }
+    }
+
+    BackHandler(enabled = active && canGoBack) {
+        notice = null
+        error = null
+        browser?.goBack()
+    }
+
+    // A stalled network must leave a usable retry screen instead of a blank page.
+    LaunchedEffect(browser, progress, active) {
+        if (active && browser != null && progress in 1..99) {
+            kotlinx.coroutines.delay(30_000)
+            browser?.stopLoading()
+            error = "Requests is taking too long to respond. Check that HP Envy and Tailscale are connected, then try again."
+        }
+    }
+
+    DisposableEffect(browser, active) {
+        if (active) browser?.onResume() else browser?.onPause()
+        onDispose { }
+    }
+    DisposableEffect(Unit) {
+        onDispose {
+            alive = false
+            browser?.apply { stopLoading(); onPause(); destroy() }
+            CookieManager.getInstance().flush()
+            client.dispatcher.cancelAll()
+        }
+    }
+
+    CompositionLocalProvider(LocalContentColor provides MaterialTheme.colorScheme.onSurface) {
+    BoxWithConstraints(modifier.fillMaxSize()) {
+        val tabletTop = if (maxWidth >= 768.dp) 66.dp else 0.dp
+        Column(Modifier.fillMaxSize().statusBarsPadding().padding(
+            top = tabletTop,
+            bottom = LocalNuvioBottomNavigationOverlayPadding.current,
+        )) {
+            Row(Modifier.fillMaxWidth().padding(horizontal = 8.dp), horizontalArrangement = Arrangement.SpaceBetween) {
+                TextButton(onClick = { load("/") }, modifier = Modifier.focusRequester(toolbarFocus)) { Text("Discover") }
+                TextButton(onClick = { load("/requests") }) { Text("Requests") }
+                IconButton(onClick = { browser?.let { if (it.canGoBack()) it.goBack() else load("/") } }) {
+                    Icon(Icons.Default.ArrowBack, "Back in Discover")
+                }
+                IconButton(onClick = { error = null; notice = null; browser?.reload() }) {
+                    Icon(Icons.Default.Refresh, "Refresh Discover")
+                }
+                Box {
+                    IconButton(onClick = { menu = true }) { Icon(Icons.Default.MoreVert, "Discover account options") }
+                    DropdownMenu(expanded = menu, onDismissRequest = { menu = false }) {
+                        DropdownMenuItem(text = { Text("Sign out of Requests") }, onClick = { menu = false; confirmSignOut = true })
+                    }
+                }
+            }
+            if (progress in 1..99 && error == null) LinearProgressIndicator(modifier = Modifier.fillMaxWidth())
+            currentTitle?.let { title ->
+                FilledTonalButton(
+                    enabled = !openingTitle && openTitle != null && error == null,
+                    modifier = Modifier.fillMaxWidth().padding(horizontal = 12.dp),
+                    onClick = {
+                        if (!SeerrPolicy.trusted(browser?.url)) return@FilledTonalButton
+                        val cookie = CookieManager.getInstance().getCookie(SeerrPolicy.origin).orEmpty()
+                        openingTitle = true
+                        notice = null
+                        scope.launch {
+                            try {
+                                val preview = withContext(Dispatchers.IO) {
+                                    val request = Request.Builder().url(SeerrPolicy.origin + title.apiPath)
+                                        .header("Cookie", cookie).header("Accept", "application/json").build()
+                                    client.newCall(request).execute().use { response ->
+                                        check(response.isSuccessful) { "Please sign in to Requests and try again." }
+                                        val detail = JSONObject(response.body?.string().orEmpty())
+                                        check(detail.optString("id") == title.tmdbId) { "This title could not be matched safely." }
+                                        val imdb = SeerrPolicy.imdb(detail.optJSONObject("externalIds")?.optString("imdbId"))
+                                            ?: SeerrPolicy.imdb(detail.optString("imdbId"))
+                                            ?: throw IllegalStateException("This title has no IMDb match yet. You can still request it here.")
+                                        val name = detail.optString(if (title.mediaType == "tv") "name" else "title")
+                                        check(name.isNotBlank()) { "This title could not be loaded." }
+                                        val poster = detail.optString("posterPath").takeIf { it.startsWith("/") }
+                                        MetaPreview(id = imdb, type = title.nuvioType, name = name,
+                                            poster = poster?.let { "https://image.tmdb.org/t/p/w500$it" })
+                                    }
+                                }
+                                if (alive && activeNow && currentTitle == title) openTitle?.invoke(preview)
+                            } catch (cancelled: kotlinx.coroutines.CancellationException) {
+                                throw cancelled
+                            } catch (failure: Exception) {
+                                if (alive) notice = when (failure) {
+                                    is IllegalStateException -> failure.message
+                                    else -> "Couldn't reach Requests. Check Tailscale and try again."
+                                }
+                            } finally { openingTitle = false }
+                        }
+                    },
+                ) { Text(if (openingTitle) "Opening title…" else "Watch in Nuvio") }
+            }
+            notice?.let { Text(it, Modifier.padding(12.dp), style = MaterialTheme.typography.bodyMedium) }
+            if (error != null) {
+                Column(Modifier.padding(24.dp)) {
+                    Text("Requests is unavailable", style = MaterialTheme.typography.titleLarge)
+                    Spacer(Modifier.height(8.dp))
+                    Text(error!!)
+                    Spacer(Modifier.height(12.dp))
+                    Button(onClick = { load("/") }) { Text("Try again") }
+                    Text("Your Nuvio library and downloads are still available.", Modifier.padding(top = 12.dp))
+                }
+            }
+            AndroidView(
+                modifier = if (error == null) Modifier.fillMaxWidth().weight(1f).clipToBounds() else Modifier.size(0.dp),
+                factory = { ctx ->
+                    WebView(ctx).apply {
+                        browser = this
+                        setBackgroundColor(0xff101827.toInt())
+                        settings.javaScriptEnabled = true
+                        settings.domStorageEnabled = true
+                        settings.allowFileAccess = false
+                        settings.allowContentAccess = false
+                        settings.mixedContentMode = WebSettings.MIXED_CONTENT_NEVER_ALLOW
+                        settings.setSupportMultipleWindows(false)
+                        settings.mediaPlaybackRequiresUserGesture = true
+                        settings.builtInZoomControls = false
+                        CookieManager.getInstance().setAcceptThirdPartyCookies(this, false)
+                        webChromeClient = object : WebChromeClient() {
+                            override fun onProgressChanged(view: WebView, newProgress: Int) { if (alive) progress = newProgress }
+                        }
+                        webViewClient = object : WebViewClient() {
+                            override fun shouldOverrideUrlLoading(view: WebView, request: WebResourceRequest): Boolean {
+                                val url = request.url.toString()
+                                if (url == "afz-seerr://toolbar" && SeerrPolicy.trusted(view.url)) {
+                                    toolbarFocus.requestFocus(); return true
+                                }
+                                if (SeerrPolicy.trusted(url)) return false
+                                if (request.hasGesture() && request.isForMainFrame && request.url.scheme == "https") {
+                                    runCatching { context.startActivity(Intent(Intent.ACTION_VIEW, request.url)) }
+                                }
+                                return true
+                            }
+                            override fun onPageStarted(view: WebView, url: String, favicon: android.graphics.Bitmap?) {
+                                if (alive) { progress = 1; currentTitle = null }
+                            }
+                            override fun doUpdateVisitedHistory(view: WebView, url: String?, isReload: Boolean) {
+                                if (alive) { currentTitle = SeerrPolicy.title(url); canGoBack = view.canGoBack() }
+                            }
+                            override fun onPageFinished(view: WebView, url: String) {
+                                if (!alive || !SeerrPolicy.trusted(url)) return
+                                currentTitle = SeerrPolicy.title(url)
+                                canGoBack = view.canGoBack()
+                                CookieManager.getInstance().flush()
+                                view.evaluateJavascript(ctx.assets.open("seerr-tv.js").bufferedReader().use { it.readText() }, null)
+                            }
+                            override fun onReceivedError(view: WebView, request: WebResourceRequest, failure: WebResourceError) {
+                                if (alive && request.isForMainFrame) error = "Connect Tailscale and make sure HP Envy is online, then try again."
+                            }
+                            override fun onReceivedHttpError(view: WebView, request: WebResourceRequest, response: WebResourceResponse) {
+                                if (alive && request.isForMainFrame && response.statusCode >= 500) error = "The Requests server is temporarily unavailable. Try again in a moment."
+                            }
+                            override fun onReceivedSslError(view: WebView, handler: SslErrorHandler, failure: SslError) {
+                                handler.cancel()
+                                if (alive) error = "The server's secure connection could not be verified. Please check its certificate and the device time."
+                            }
+                        }
+                        if (preferences.getString("owner", null) != ownerHash) resetSession(this) { loadUrl(SeerrPolicy.origin + "/") }
+                        else loadUrl(SeerrPolicy.origin + "/")
+                    }
+                },
+            )
+        }
+    }
+    }
+    if (confirmSignOut) AlertDialog(
+        onDismissRequest = { confirmSignOut = false },
+        title = { Text("Sign out of Requests?") },
+        text = { Text("Your Nuvio profile and downloads stay signed in. You can sign into Requests again with your existing Jellyfin account.") },
+        confirmButton = { TextButton(onClick = {
+            confirmSignOut = false
+            browser?.let { view -> resetSession(view) { load("/login") } }
+        }) { Text("Sign out") } },
+        dismissButton = { TextButton(onClick = { confirmSignOut = false }) { Text("Cancel") } },
+    )
+}
