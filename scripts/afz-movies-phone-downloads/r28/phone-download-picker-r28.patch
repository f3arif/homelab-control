+
+    @Test fun structuredRemuxQualityIsKeptAtBottom() {
+        val remux = source("1080p", 4.0).copy(clientResolve = StreamClientResolve(
+            stream = StreamClientResolveStream(raw = StreamClientResolveRaw(parsed = StreamClientResolveParsed(quality = "REMUX")))))
+        val saver = source("720p", 0.8)
+        val result = picker(group(remux, saver))
+        assertEquals(saver, result.recommendation?.stream)
+        assertEquals("Large / Original quality", result.groups.single().addonName)
+    }
+
+    @Test fun tiesPreserveSourceOrderAndUnknownBytesAreNotPresentedAsRecommended() {
+        val first = source("1080p first")
+        val second = source("1080p second")
+        val result = picker(group(first, second))
+        assertEquals(first, result.recommendation?.stream)
+        assertTrue(result.recommendation!!.heading.startsWith("Closest available"))
+        assertEquals(listOf(second), result.files())
+    }
+}
