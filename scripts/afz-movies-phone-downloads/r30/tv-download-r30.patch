+internal data class DetailActionPresentation(
+    val compactDownloadAction: DetailSecondaryAction?,
+    val tvDownloadAction: DetailSecondaryAction?,
+    val secondaryActions: List<DetailSecondaryAction>,
+)
+
+internal fun detailActionPresentation(
+    device: DownloadDevice,
+    secondaryActions: List<DetailSecondaryAction>,
+    deviceDownloadAction: DetailSecondaryAction?,
+): DetailActionPresentation = if (device == DownloadDevice.Television) {
+    DetailActionPresentation(null, deviceDownloadAction, secondaryActions)
+} else {
+    DetailActionPresentation(deviceDownloadAction, null, secondaryActions)
+}
+
+@OptIn(ExperimentalFoundationApi::class)
+@Composable
+private fun TvDownloadAction(action: DetailSecondaryAction, height: Dp) {
+    var focused by remember { mutableStateOf(false) }
+    Surface(
+        shape = RoundedCornerShape(40.dp),
+        color = if (focused || action.isActive) MaterialTheme.colorScheme.onBackground else MaterialTheme.colorScheme.surfaceVariant,
+        contentColor = if (focused || action.isActive) MaterialTheme.colorScheme.background else MaterialTheme.colorScheme.onSurface,
+        tonalElevation = if (focused) 8.dp else 4.dp,
+    ) {
+        Row(
+            modifier = Modifier
+                .height(height)
+                .widthIn(min = 176.dp)
+                .onFocusChanged { focused = it.isFocused }
+                .focusable()
+                .combinedClickable(onClick = action.onClick, onLongClick = action.onLongClick, role = Role.Button),
+            horizontalArrangement = Arrangement.Center,
+            verticalAlignment = Alignment.CenterVertically,
+        ) {
+            Icon(imageVector = action.icon, contentDescription = null, modifier = Modifier.size(21.dp))
+            Spacer(modifier = Modifier.width(8.dp))
+            Text(text = action.label, style = MaterialTheme.typography.titleSmall, maxLines = 1, overflow = TextOverflow.Ellipsis)
+        }
+    }
+}
