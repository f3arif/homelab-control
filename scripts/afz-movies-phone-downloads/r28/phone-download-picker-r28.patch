+package com.nuvio.app.features.streams
+
+/** Share offers and running work, but let a new sheet visit retry a failed or empty lookup. */
+internal fun StreamsUiState.hasReusableStreamLoad(): Boolean =
+    isAnyLoading || groups.any { it.isLoading || it.streams.isNotEmpty() }
+
+/** Download filtering must not turn an add-on setup or network failure into a no-files result. */
+internal fun StreamsUiState.deviceDownloadEmptyReason(): StreamsEmptyStateReason? {
+    val selected = filteredGroups
+    if (selected.isNotEmpty() && selected.all { !it.error.isNullOrBlank() }) {
+        return StreamsEmptyStateReason.StreamFetchFailed
+    }
+    return emptyStateReason?.takeUnless { it == StreamsEmptyStateReason.NoStreamsFound }
+}
