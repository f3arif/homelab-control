+/** Explicit file rows are kept ahead of broad quality/TV auto choices on phones. */
+internal fun StreamItem.isExplicitAfzPhoneSource(): Boolean {
+    val label = streamLabel.trim().lowercase()
+    return label.startsWith("afz phone 1080p") || label.startsWith("afz tv mobile 1080p")
+}
+
+private fun StreamItem.phoneSourcePriority(): Int {
+    val label = streamLabel.trim().lowercase()
+    return when {
+        isExplicitAfzPhoneSource() -> 0
+        label.startsWith("afz auto mobile") -> 1
+        label.startsWith("afz auto data saver") -> 2
+        label.startsWith("afz auto 1080p") -> 3
+        label.startsWith("afz play best") -> 5
+        label.startsWith("auto-save") || afzStreamActionOrNull() != null -> 6
+        label.startsWith("afz auto tv") -> 8
+        label.startsWith("afz auto 4k") -> 9
+        downloadResolution() == 1080 && !downloadIsRemux() && isDeviceVideoCandidate(false) -> 4
+        else -> 7
+    }
+}
+
+/** This applies even when no source meets the phone recommendation budget. */
+internal fun List<StreamItem>.withPhoneMobileSourcesFirst(): List<StreamItem> =
+    sortedBy { it.phoneSourcePriority() }
+
+internal fun List<StreamItem>.orderedPlaybackSources(
+    device: DownloadDevice, downloadOnly: Boolean,
+): List<StreamItem> = when {
+    downloadOnly -> this
+    device == DownloadDevice.Phone -> withPhoneMobileSourcesFirst()
+    else -> withAfzQuickActionsNearTop()
+}
+
