 internal data class PhonePlaybackPlacement(
     val recommendation: DownloadRecommendation,
     val groupIndex: Int,
     val anchor: StreamItem,
 )
 
+/** Concrete AFZ rows that are explicitly designed for phone playback/downloads. */
+internal fun StreamItem.isExplicitAfzPhoneSource(): Boolean {
+    val label = streamLabel.trim().lowercase()
+    return label.startsWith("afz phone 1080p") ||
+        label.startsWith("afz tv mobile 1080p")
+}
+
+private fun StreamItem.phoneSourcePriority(): Int {
+    val label = streamLabel.trim().lowercase()
+    return when {
+        isExplicitAfzPhoneSource() -> 0
+        label.startsWith("afz auto mobile") -> 1
+        label.startsWith("afz auto data saver") -> 2
+        label.startsWith("afz auto 1080p") -> 3
+        downloadResolution() == 1080 -> 4
+        label.startsWith("afz play best") -> 5
+        label.startsWith("auto-save") || label.startsWith("afz auto download") -> 6
+        label.startsWith("afz auto tv") -> 8
+        label.startsWith("afz auto 4k") -> 9
+        else -> 7
+    }
+}
+
+/** Stable phone-only ordering. Other device classes retain their original presentation. */
+internal fun List<StreamItem>.withPhoneMobileSourcesFirst(): List<StreamItem> =
+    withIndex()
+        .sortedWith(compareBy<IndexedValue<StreamItem>> { it.value.phoneSourcePriority() }.thenBy { it.index })
+        .map { it.value }
+
