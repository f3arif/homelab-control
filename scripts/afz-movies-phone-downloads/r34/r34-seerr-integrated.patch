@@ -0,0 +1,34 @@
+package com.nuvio.app.features.seerr
+
+import org.junit.Test
+import org.junit.Assert.*
+
+class SeerrPolicyTest {
+    @Test fun acceptsOnlyTheConfiguredSecureOrigin() {
+        assertTrue(SeerrPolicy.trusted(SeerrPolicy.origin + "/movie/123"))
+        listOf("http://hpenvy.tailc9bb62.ts.net:18799/", "https://hpenvy.tailc9bb62.ts.net/",
+            "https://hpenvy.tailc9bb62.ts.net:18799.evil.test/", "https://hpenvy.tailc9bb62.ts.net.evil.test:18799/",
+            "https://evil.test@hpenvy.tailc9bb62.ts.net:18799/", "file:///etc/passwd", "javascript:alert(1)",
+            "https://evil.test/", "https://hpenvy.tailc9bb62.ts.net:18798/", "not a url").forEach {
+            assertFalse(it, SeerrPolicy.trusted(it))
+        }
+    }
+    @Test fun mapsExactMovieAndSeriesIdentities() {
+        assertEquals(SeerrTitle("movie", "123"), SeerrPolicy.title(SeerrPolicy.origin + "/movie/123?x=y"))
+        val tv = SeerrPolicy.title(SeerrPolicy.origin + "/tv/456/")!!
+        assertEquals("series", tv.nuvioType)
+        assertEquals("/api/v1/tv/456", tv.apiPath)
+    }
+    @Test fun rejectsNonTitleRoutesAndMalformedIds() {
+        listOf("/movie/0", "/movie/-1", "/movie/123/other", "/movie/12345678901", "/login", "/tv/abc",
+            "/movie/../123", "/movie/%2F123").forEach { assertNull(it, SeerrPolicy.title(SeerrPolicy.origin + it)) }
+        assertNull(SeerrPolicy.title("https://evil.test/movie/123"))
+    }
+    @Test fun neverGuessesAnImdbIdentityFromATitle() {
+        assertEquals("tt1234567", SeerrPolicy.imdb("tt1234567"))
+        listOf("1234567", "tmdb:1234", "tt123", "tt1234567:1:2", "A movie title", "tt1234567/evil").forEach {
+            assertNull(SeerrPolicy.imdb(it))
+        }
+        assertNull(SeerrPolicy.imdb(null))
+    }
+}
