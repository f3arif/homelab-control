@@ -0,0 +1,51 @@
+package com.nuvio.app.features.streams
+
+import kotlin.test.*
+
+class StreamLoadResultPolicyTest {
+    private fun group(id: String = "AFZ", loading: Boolean = false, error: String? = null, offers: Boolean = false) =
+        AddonStreamGroup(id, id, if (offers) listOf(StreamItem(url = "https://example.test/file.mkv", addonName = id, addonId = id))
+            else emptyList(), isLoading = loading, error = error)
+
+    @Test fun completedNetworkFailureIsRetriedOnNewSheetVisit() {
+        val failed = StreamsUiState(groups = listOf(group(error = "Stream source timed out after 12 seconds")),
+            emptyStateReason = StreamsEmptyStateReason.StreamFetchFailed)
+        assertFalse(failed.hasReusableStreamLoad())
+        assertEquals(StreamsEmptyStateReason.StreamFetchFailed, failed.deviceDownloadEmptyReason())
+    }
+
+    @Test fun emptyResultsAreNotPinnedUntilManualRefresh() {
+        val empty = StreamsUiState(groups = listOf(group()), emptyStateReason = StreamsEmptyStateReason.NoStreamsFound)
+        assertFalse(empty.hasReusableStreamLoad())
+        assertNull(empty.deviceDownloadEmptyReason())
+    }
+
+    @Test fun addonAvailabilityCanBeRecheckedAfterManifestFinishesLoading() {
+        for (reason in listOf(StreamsEmptyStateReason.NoAddonsInstalled, StreamsEmptyStateReason.NoCompatibleAddons)) {
+            val state = StreamsUiState(emptyStateReason = reason)
+            assertFalse(state.hasReusableStreamLoad())
+            assertEquals(reason, state.deviceDownloadEmptyReason())
+        }
+    }
+
+    @Test fun inFlightWorkIsReusedEvenBeforeProviderRowsExist() {
+        assertTrue(StreamsUiState(isAnyLoading = true).hasReusableStreamLoad())
+        assertTrue(StreamsUiState(groups = listOf(group(loading = true))).hasReusableStreamLoad())
+    }
+
+    @Test fun usableOffersSurvivePartialProviderFailureWithoutDuplicateFetch() {
+        val state = StreamsUiState(groups = listOf(group(offers = true), group("Other", error = "Unavailable")))
+        assertTrue(state.hasReusableStreamLoad())
+        assertNull(state.deviceDownloadEmptyReason())
+    }
+
+    @Test fun selectedProviderFailureIsNotHiddenByAnotherProvidersOffers() {
+        val state = StreamsUiState(groups = listOf(group(offers = true), group("Other", error = "Unavailable")), selectedFilter = "Other")
+        assertEquals(StreamsEmptyStateReason.StreamFetchFailed, state.deviceDownloadEmptyReason())
+    }
+
+    @Test fun aSuccessfulEmptyProviderIsDistinctFromAFailedProvider() {
+        val state = StreamsUiState(groups = listOf(group(offers = true), group("Other")), selectedFilter = "Other")
+        assertNull(state.deviceDownloadEmptyReason())
+    }
+}
