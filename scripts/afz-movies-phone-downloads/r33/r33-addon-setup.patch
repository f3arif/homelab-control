+package com.nuvio.app.features.addons
+
+import kotlinx.coroutines.flow.MutableStateFlow
+
+/** Canonicalize only the transport scheme; provider paths and tokens remain case-sensitive. */
+internal fun normalizeAddonManifestUrl(rawUrl: String): String {
+    val trimmed = rawUrl.trim()
+    require(trimmed.isNotEmpty())
+    val transportUrl = when {
+        trimmed.startsWith("https://", ignoreCase = true) -> "https://" + trimmed.substring(8)
+        trimmed.startsWith("http://", ignoreCase = true) -> "http://" + trimmed.substring(7)
+        trimmed.startsWith("stremio://", ignoreCase = true) -> "https://" + trimmed.substring(10)
+        else -> "https://$trimmed"
+    }.substringBefore("#")
+    val query = transportUrl.substringAfter("?", "")
+    val path = transportUrl.substringBefore("?").trimEnd('/')
+    val manifestPath = if (path.endsWith("/manifest.json")) path else "$path/manifest.json"
+    return if (query.isEmpty()) manifestPath else "$manifestPath?$query"
+}
+
+/** Recheck after manifest fetch and commit atomically, including StateFlow update retries. */
+internal fun MutableStateFlow<AddonsUiState>.installAddonIfAbsent(addon: ManagedAddon): Boolean {
+    while (true) {
+        val current = value
+        if (current.addons.any { it.manifestUrl == addon.manifestUrl }) return false
+        if (compareAndSet(current, current.copy(addons = current.addons + addon))) return true
+    }
+}
