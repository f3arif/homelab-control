@@ -0,0 +1,28 @@
+package com.nuvio.app.features.seerr
+
+import java.net.URI
+
+/** Only this origin receives the embedded account's cookies or native integration. */
+internal object SeerrPolicy {
+    const val origin = "https://hpenvy.tailc9bb62.ts.net:18799"
+    private val expected = URI(origin)
+    fun trusted(url: String?): Boolean = runCatching {
+        val u = URI(url ?: return false)
+        u.scheme.equals("https", true) && u.host.equals(expected.host, true) &&
+            u.port == expected.port && u.rawUserInfo == null
+    }.getOrDefault(false)
+
+    fun title(url: String?): SeerrTitle? {
+        if (!trusted(url)) return null
+        val match = Regex("^/(movie|tv)/([1-9][0-9]{0,9})/?$")
+            .matchEntire(URI(url).path ?: return null) ?: return null
+        return SeerrTitle(match.groupValues[1], match.groupValues[2])
+    }
+
+    fun imdb(value: String?): String? = value?.takeIf { Regex("tt[0-9]{7,12}").matches(it) }
+}
+
+internal data class SeerrTitle(val mediaType: String, val tmdbId: String) {
+    val apiPath: String get() = "/api/v1/$mediaType/$tmdbId"
+    val nuvioType: String get() = if (mediaType == "tv") "series" else "movie"
+}
