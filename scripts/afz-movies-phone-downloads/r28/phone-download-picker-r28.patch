+package com.nuvio.app.features.streams
+
+import com.nuvio.app.features.downloads.isDynamicDownloadUrl
+import kotlin.math.abs
+
+internal data class StreamListPresentation(
+    val groups: List<AddonStreamGroup>,
+    val recommendation: DownloadRecommendation? = null,
+)
+
+/** Keep playback order intact; downloads rank concrete files across all selected add-ons. */
+internal fun streamListPresentation(
+    groups: List<AddonStreamGroup>,
+    device: DownloadDevice,
+    isEpisode: Boolean,
+    debridEnabled: Boolean,
+    downloadOnly: Boolean,
+): StreamListPresentation {
+    if (!downloadOnly) return StreamListPresentation(groups)
+    val streams = groups.flatMap { it.streams }.filter {
+        it.fixedDeviceDownloadStreamOrNull(debridEnabled) != null
+    }
+    val recommendation = recommendDeviceDownload(streams, device, isEpisode, debridEnabled)
+    val target = downloadTarget(device, isEpisode)
+    val mobileMaximum = if (isEpisode) target.maxGb * 2 else maxOf(8.0, target.maxGb)
+    val saverMaximum = if (isEpisode) target.minGb else 1.5
+    data class Candidate(val stream: StreamItem, val section: DownloadSection, val size: Double?)
+    val candidates = streams.filter { it != recommendation?.stream }.map { stream ->
+        val size = stream.downloadSizeGb()
+        val resolution = stream.downloadResolution()
+        val section = when {
+            stream.downloadIsRemux() || (size != null && size > mobileMaximum) -> DownloadSection.Large
+            resolution == 2160 -> DownloadSection.UltraHd
+            resolution == 1080 && size != null && size in saverMaximum..mobileMaximum -> DownloadSection.Mobile
+            (resolution == 1080 && size != null && size < saverMaximum) ||
+                resolution in listOf(720, 576, 480) -> DownloadSection.DataSaver
+            resolution == 1080 -> DownloadSection.FullHd
+            else -> DownloadSection.Other
+        }
+        Candidate(stream, section, size)
+    }.sortedWith(compareBy<Candidate> { it.section.ordinal }
+        .thenBy { if (it.size != null && it.size in target.minGb..target.maxGb) 0 else 1 }
+        .thenBy { if (it.stream.downloadIsCached()) 0 else 1 }
+        .thenBy { candidate -> candidate.size?.let { abs(it - (target.minGb + target.maxGb) / 2) } ?: Double.MAX_VALUE })
+    val sections = candidates.groupBy { it.section }.map { (section, rows) ->
+        AddonStreamGroup(
+            addonName = section.label,
+            addonId = "device-download:${section.name}",
+            streams = rows.map { it.stream },
+        )
+    }
+    // Preserve loading and error feedback after regrouping files by download suitability.
+    val pending = groups.filter { it.isLoading || it.error != null }.map { it.copy(streams = emptyList()) }
+    return StreamListPresentation(sections + pending, recommendation)
+}
+
+internal fun StreamItem.fixedDeviceDownloadStreamOrNull(debridEnabled: Boolean): StreamItem? =
+    deviceDownloadStreamOrNull(debridEnabled)?.takeUnless {
+        isDynamicDownloadUrl(it.playableDirectUrl.orEmpty())
+    }
+
+private enum class DownloadSection(val label: String) {
+    Mobile("Mobile · 1080p"),
+    DataSaver("Data Saver"),
+    FullHd("Other 1080p sources"),
+    Other("Other sources"),
+    UltraHd("4K sources"),
+    Large("Large / Original quality"),
+}
