diff --git a/composeApp/src/commonTest/kotlin/com/nuvio/app/features/streams/DeviceDownloadPickerTest.kt b/composeApp/src/commonTest/kotlin/com/nuvio/app/features/streams/DeviceDownloadPickerTest.kt
